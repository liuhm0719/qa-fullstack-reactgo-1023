{
  "apiVersion": "astra/v1",
  "kind": "Application",
  "metadata": { "name": "qa-fullstack-reactgo-1023" },
  "spec": {
    "components": {
      "web": {
        "type": "service",
        "source": "web",
        "runtime": { "kind": "oci", "dockerfile": "web/Dockerfile" },
        "bindings": { "api": { "resource": "api" } }
      },
      "api": {
        "type": "service",
        "source": "api",
        "runtime": { "kind": "oci", "dockerfile": "api/Dockerfile" }
      }
    },
    "environments": { "staging": { "target": "k3s", "vars": {} } }
  }
}
